---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Reset password — SlopSecurity">
  <div class="auth-layout">
    <section class="auth-intro"><span class="eyebrow">Account recovery</span><h1>A fresh start.</h1><p>Choose a new password and get back to your protection in just a few moments.</p><div class="auth-aside">Enter your username to recover your account. For your security, choose a password you haven't used before.</div></section>
    <form id="f" class="form"><div class="form-head"><h2>Reset password</h2><p class="muted small">Forgetting things happens to the best of us.</p></div><label for="username">Username</label><input id="username" required /><label for="password">New password</label><input id="password" type="password" autocomplete="new-password" required placeholder="Choose a new password" /><button type="submit" class="btn-full">Reset password →</button><div id="msg"></div><p class="form-note">Remembered it after all? <a href="/login">Back to login</a></p></form>
  </div>
  <script is:inline>
    document.getElementById('f').addEventListener('submit', async (e) => {
      e.preventDefault();
      const r = await fetch(window.API + '/api/password-reset', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username: document.getElementById('username').value, password: document.getElementById('password').value }) });
      const data = await r.json();
      document.getElementById('msg').innerHTML = `<p class="notice ${r.ok ? 'success' : 'error'}">${r.ok ? 'Password reset. You can now log in with the new password.' : data.error}</p>`;
    });
  </script>
</Layout>
