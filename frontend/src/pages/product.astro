---
import Layout from '../layouts/Layout.astro';
---
<Layout title="SlopSecurity — Plan details">
  <a href="/shop" class="muted">&larr; Back to plans</a>
  <div id="product" style="margin-top:1rem"></div>

  <script is:inline>
    function addToCart(id, name, price) {
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      cart.push({ id, name, price });
      localStorage.setItem('cart', JSON.stringify(cart));
      alert(name + ' added to cart');
    }
    window.addToCart = addToCart;
    (async () => {
      const id = new URLSearchParams(location.search).get('id');
      const r = await fetch(window.API + '/api/products/' + encodeURIComponent(id), { credentials: 'include' });
      const p = await r.json();
      const price = typeof p.price === 'number' ? p.price.toFixed(2) : p.price;
      // VULN-07 Stored XSS: description rendered unescaped.
      document.getElementById('product').innerHTML = `
        <div class="card" style="max-width:520px">
          <span class="badge">SlopSecurity</span>
          <h1>${p.name || 'Unknown plan'}</h1>
          <div class="price">€${price || '0.00'} <small>/yr</small></div>
          <div style="margin:.4rem 0 .2rem">${p.description || ''}</div>
          <div class="spacer"></div>
          <button class="btn-full" onclick='addToCart(${p.id}, ${JSON.stringify(p.name || "")}, ${p.price || 0})'>Add to cart</button>
        </div>`;
    })();
  </script>
</Layout>
