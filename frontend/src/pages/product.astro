---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Plan details — SlopSecurity">
  <a href="/shop" class="back-link">← Back to all plans</a>
  <div id="product"><p class="muted">Loading your plan…</p></div>
  <div id="msg"></div>
  <script is:inline>
    (async () => {
      const id = new URLSearchParams(location.search).get('id');
      try {
        const r = await fetch(window.API + '/api/products/' + encodeURIComponent(id), { credentials: 'include' });
        const p = await r.json();
        if (!r.ok) { document.getElementById('product').innerHTML = `<p class="notice error">${p.error || 'Plan not found.'}</p>`; return; }
        const price = typeof p.price === 'number' ? p.price.toFixed(2) : p.price;
        // VULN-07 Stored XSS: description and name rendered unescaped.
        document.getElementById('product').innerHTML = `
          <div class="product-detail">
            <div class="product-visual"><svg viewBox="0 0 90 104" fill="none"><path d="M45 3 85 17v29c0 25-18 44-40 55C23 90 5 71 5 46V17L45 3Z" fill="#c5f277" fill-opacity=".07" stroke="#c5f277" stroke-width="1"/><path d="m27 49 12 12 24-28" stroke="#c5f277" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <div>
              <span class="eyebrow">SlopSecurity / Annual subscription</span>
              <h1>${p.name || 'Unknown plan'}</h1>
              <div class="description">${p.description || ''}</div>
              <ul class="plan-checks"><li>Real-time scanning, when it's in the mood</li><li>Automatic updates and occasional surprises</li><li>A lovely green checkmark on your desktop</li></ul>
              <div class="price">€${price || '0.00'} <small>/ year · cancel anytime</small></div>
              <button id="add">Add to cart →</button>
              <p class="form-note">30-day money-back guarantee. Cancel anytime.</p>
            </div>
          </div>`;
        document.getElementById('add').addEventListener('click', () => {
          const cart = JSON.parse(localStorage.getItem('cart') || '[]');
          cart.push({ id: p.id, name: p.name, price: p.price });
          localStorage.setItem('cart', JSON.stringify(cart)); refreshCart();
          document.getElementById('msg').innerHTML = `<p class="notice success">Added to your cart. <a href="/cart">Continue to checkout →</a></p>`;
        });
      } catch (e) { document.getElementById('product').innerHTML = '<p class="notice error">Could not load this plan.</p>'; }
    })();
  </script>
</Layout>
