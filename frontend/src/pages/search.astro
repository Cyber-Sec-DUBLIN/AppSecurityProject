---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Search — SlopSecurity">
  <header class="page-header"><div><span class="eyebrow">Find your fit</span><h1>What are you looking for?</h1><p>Search plans and features to find the right protection for you.</p></div></header>
  <form id="f" class="search-bar"><input id="q" name="q" placeholder="Try “ransomware”, “VPN”, or “free”…" autocomplete="off" aria-label="Search products" /><button type="submit">Search →</button></form>
  <div id="heading" style="margin-top:2rem"></div>
  <div id="results" class="grid"></div>
  <script is:inline>
    async function run(q) {
      document.getElementById('results').innerHTML = '<p class="muted">Searching…</p>';
      try {
        const r = await fetch(window.API + '/api/search?q=' + encodeURIComponent(q), { credentials: 'include' });
        const data = await r.json();
        if (!r.ok) { document.getElementById('results').innerHTML = `<p class="notice error">${data.error}<br><code>${data.query}</code></p>`; return; }
        // VULN-08 Reflected XSS: the echoed query is written as raw HTML.
        document.getElementById('heading').innerHTML = '<h2>Results for “' + data.query + '”</h2>';
        // VULN-07 Stored XSS: each result description is raw HTML too.
        document.getElementById('results').innerHTML = (data.results || []).map((p) => `
          <div class="card"><div class="plan-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 3 4 6v5c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6l-8-3Z"/><path d="m8 12 2.5 2.5L16 9"/></svg></div><h3>${p.name}</h3><div>${p.description}</div><p class="price">€${Number(p.price).toFixed(2)} <small>/ year</small></p><div class="spacer"></div><a class="btn ghost btn-full" href="/product?id=${p.id}">View plan →</a></div>`).join('') || '<div class="empty">No results found. Try a different search.</div>';
      } catch (e) { document.getElementById('results').innerHTML = '<p class="notice error">Search is unavailable. Is the backend running?</p>'; }
    }
    document.getElementById('f').addEventListener('submit', (e) => { e.preventDefault(); run(document.getElementById('q').value); });
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) { document.getElementById('q').value = initial; run(initial); }
  </script>
</Layout>
