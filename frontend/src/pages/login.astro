---
import Layout from '../layouts/Layout.astro';
---
<Layout title="SlopShop — Login">
  <h1>Login</h1>
  <form id="f" class="form">
    <label>Username</label>
    <input id="u" autocomplete="off" />
    <label>Password</label>
    <input id="p" type="password" autocomplete="off" />
    <button type="submit">Login</button>
  </form>
  <div id="msg"></div>
  <p class="muted">Demo accounts: admin/admin123 · staff/staff123 · alice/password123</p>

  <script is:inline>
    document.getElementById('f').addEventListener('submit', async (e) => {
      e.preventDefault();
      const r = await fetch(window.API + '/api/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ username: document.getElementById('u').value, password: document.getElementById('p').value }),
      });
      if (r.ok) { location.href = '/account'; }
      else { document.getElementById('msg').innerHTML = '<p class="notice">Login failed.</p>'; }
    });
  </script>
</Layout>
