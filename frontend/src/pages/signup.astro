---
import Layout from '../layouts/Layout.astro';
---
<Layout title="SlopShop — Sign up">
  <h1>Create an account</h1>
  <form id="f" class="form">
    <label>Username</label>
    <input id="u" autocomplete="off" />
    <label>Password</label>
    <input id="p" type="password" autocomplete="off" />
    <label>Account type</label>
    <!-- VULN-06 Mass assignment: the role is chosen by the client and trusted
         by the server, so anyone can self-register as an admin. -->
    <select id="role">
      <option value="customer">customer</option>
      <option value="staff">staff</option>
      <option value="admin">admin</option>
    </select>
    <button type="submit">Sign up</button>
  </form>
  <div id="msg"></div>

  <script is:inline>
    document.getElementById('f').addEventListener('submit', async (e) => {
      e.preventDefault();
      const r = await fetch(window.API + '/api/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({
          username: document.getElementById('u').value,
          password: document.getElementById('p').value,
          role: document.getElementById('role').value,
        }),
      });
      if (r.ok) { location.href = '/account'; }
      else { document.getElementById('msg').innerHTML = '<p class="notice">Sign up failed (username may be taken).</p>'; }
    });
  </script>
</Layout>
