---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Admin console — SlopSecurity">
  <header class="page-header"><div><span class="eyebrow">Workspace administration</span><h1>Admin console.</h1><p>Manage customers, subscriptions, and the machinery behind the green checkmark.</p></div><span class="pill green">Administrator workspace</span></header>
  <div class="tabs" style="margin-top:2rem"><button class="tab active" data-tab="users">User management</button><button class="tab" data-tab="products">Products</button><button class="tab" data-tab="tools">System resources</button><button class="tab" data-tab="logout">Session preferences</button></div>
  <section id="users"><div id="user-list"><p class="muted">Loading user records…</p></div></section>
  <section id="products" style="display:none" class="split">
    <form id="new-product" class="form"><div class="form-head"><h2>Create a product</h2><p class="muted small">Add a new subscription option to the storefront.</p></div><label for="name">Product name</label><input id="name" required placeholder="SlopSecurity Enterprise" /><label for="description">Description</label><textarea id="description">All the protection you could ask for.</textarea><label for="price">Annual price (€)</label><input id="price" type="number" step="0.01" value="149.99" /><button class="btn-full" type="submit">Publish product</button><div id="product-msg"></div></form>
    <div class="panel"><h2>Existing products</h2><div id="product-list"></div></div>
  </section>
  <section id="tools" style="display:none" class="split">
    <form id="logs" class="form"><div class="form-head"><h2>System log viewer</h2><p class="muted small">Inspect local service configuration and diagnostic resources.</p></div><label for="path">Resource filename</label><input id="path" value="service.txt" /><p class="form-note">Enter the name of a resource available to the service.</p><button type="submit" class="btn-full">View resource</button></form><div class="panel"><h2>Resource contents</h2><pre id="log-output" class="output">Select a resource to view its contents.</pre></div>
  </section>
  <section id="logout" style="display:none" class="panel"><h2>After signing out</h2><p class="muted">Choose the page users are taken to when their session ends.</p><form id="redirect" class="form"><label for="next">Return page</label><input id="next" value="http://localhost:4321/" /><button type="submit">Log out and continue</button></form></section>
  <script is:inline>
    document.querySelectorAll('[data-tab]').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('[data-tab]').forEach((t) => t.classList.toggle('active', t === b));
      ['users','products','tools','logout'].forEach((id) => document.getElementById(id).style.display = id === b.dataset.tab ? '' : 'none');
    }));
    async function load() {
      const r = await fetch(window.API + '/api/admin/users', { credentials: 'include' });
      if (!r.ok) { document.getElementById('user-list').innerHTML = '<div class="empty">Login required.<br /><a href="/login">Log in →</a></div>'; return; }
      const users = await r.json();
      // VULN-09: plaintext passwords listed; VULN-07: raw profile HTML.
      document.getElementById('user-list').innerHTML = `<div class="table-wrap"><table><thead><tr><th>ID</th><th>Username</th><th>Password</th><th>Role</th><th>Address</th><th></th></tr></thead><tbody>` + users.map((u) => `<tr><td class="mono">${u.id}</td><td>${u.username}</td><td class="mono">••••••••</td><td><span class="role">${u.role}</span></td><td>${u.address || ''}</td><td><button class="danger" data-delete="${u.id}">Delete</button></td></tr>`).join('') + '</tbody></table></div>';
      document.querySelectorAll('[data-delete]').forEach((b) => b.addEventListener('click', async () => {
        if (!confirm('Delete this synthetic user?')) return;
        // VULN-12: no CSRF token; VULN-05: no admin check server-side.
        await fetch(window.API + '/api/admin/users/' + b.dataset.delete, { method: 'DELETE', credentials: 'include' }); load();
      }));
    }
    async function loadProducts() {
      const products = await (await fetch(window.API + '/api/products', { credentials: 'include' })).json();
      document.getElementById('product-list').innerHTML = products.map((p) => `<div style="padding:.8rem 0;border-bottom:1px solid var(--line)"><strong>${p.name}</strong><span class="muted" style="float:right">€${Number(p.price).toFixed(2)}</span><br /><button class="danger" data-product-delete="${p.id}" style="margin-top:.5rem">Delete product</button></div>`).join('');
      document.querySelectorAll('[data-product-delete]').forEach((b) => b.addEventListener('click', async () => {
        if (!confirm('Delete this synthetic product?')) return;
        await fetch(window.API + '/api/products/' + b.dataset.productDelete, { method: 'DELETE', credentials: 'include' }); loadProducts();
      }));
    }
    document.getElementById('new-product').addEventListener('submit', async (e) => {
      e.preventDefault();
      const r = await fetch(window.API + '/api/products', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify({ name: document.getElementById('name').value, description: document.getElementById('description').value, price: Number(document.getElementById('price').value) }) });
      const data = await r.json();
      document.getElementById('product-msg').innerHTML = `<p class="notice ${r.ok ? 'success' : 'error'}">${r.ok ? 'Product published.' : data.error}</p>`;
      if (r.ok) loadProducts();
    });
    document.getElementById('logs').addEventListener('submit', async (e) => {
      e.preventDefault();
      const r = await fetch(window.API + '/api/logs?file=' + encodeURIComponent(document.getElementById('path').value), { credentials: 'include' });
      const data = await r.json();
      document.getElementById('log-output').textContent = data.contents || data.error || 'No content';
    });
    document.getElementById('redirect').addEventListener('submit', (e) => {
      e.preventDefault(); location.href = window.API + '/api/logout?next=' + encodeURIComponent(document.getElementById('next').value);
    });
    load(); loadProducts();
  </script>
</Layout>
