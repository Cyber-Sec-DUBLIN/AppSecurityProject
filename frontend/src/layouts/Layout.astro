---
const { title = 'SlopSecurity' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="SlopSecurity keeps your digital life simple with thoughtful protection for all your devices." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <link rel="stylesheet" href="/style.css" />
    <script is:inline>window.API = 'http://localhost:8080';</script>
  </head>
  <body>
    <header class="nav">
      <a class="brand" href="/">
        <svg viewBox="0 0 40 44" fill="none" aria-hidden="true">
          <path d="M20 2 37 8v13c0 10-7.5 17.5-17 21C10.5 38.5 3 31 3 21V8l17-6Z" fill="#c5f277"/>
          <path d="m12 21 5.5 5.5L28 15" stroke="#152008" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Slop<span class="mark">Security</span></span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/shop">Plans</a>
        <a href="/search">Search</a>
        <a class="cart-link" href="/cart">Cart <span id="cart-count">0</span></a>
        <a href="/account">Account</a>
        <a id="admin-link" href="/admin" style="display:none">Admin</a>
        <span id="who"></span>
        <a id="login-link" href="/login">Log in</a>
        <a id="signup-link" class="btn" href="/signup" style="padding:.45rem .85rem">Get protected</a>
        <a href="#" id="logout" style="display:none">Log out</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <div class="foot-brand">SlopSecurity<span style="color:var(--primary)">.</span></div>
      <p><strong>Fictional antivirus. Real commitment to the bit.</strong><br />SlopSecurity protects nothing and admits almost everything. Localhost training only.<br />© 2026 SlopSecurity. Peace of mind sold separately.</p>
    </footer>
    <script is:inline>
      function refreshCart() {
        const cart = JSON.parse(localStorage.getItem('cart') || '[]');
        document.getElementById('cart-count').textContent = cart.length;
      }
      refreshCart();
      (async () => {
        try {
          const r = await fetch(window.API + '/api/me', { credentials: 'include' });
          if (r.ok) {
            const u = await r.json();
            document.getElementById('who').textContent = u.username + ' · ' + u.role;
            document.getElementById('logout').style.display = '';
            document.getElementById('login-link').style.display = 'none';
            document.getElementById('signup-link').style.display = 'none';
            // VULN-05: hiding a link is not access control. /admin works for anyone.
            if (u.role === 'admin') document.getElementById('admin-link').style.display = '';
          }
        } catch (e) {}
        const lo = document.getElementById('logout');
        if (lo) lo.addEventListener('click', async (e) => {
          e.preventDefault();
          await fetch(window.API + '/api/logout', { method: 'POST', credentials: 'include' });
          location.href = '/';
        });
      })();
    </script>
  </body>
</html>
